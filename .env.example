# Copia este archivo como ".env" y ajusta los valores si lo necesitas.
# cp .env.example .env

# --- Rutas ---
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
VECTOR_DB_DIR=./data/chroma_db
COLLECTION_NAME=base_conocimiento

# --- Chunking (Unidad 3) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Embeddings (Unidad 1) — modelo local, multilingüe, gratuito ---
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- Retrieval (Unidad 1) ---
TOP_K=4
HYBRID_SEARCH=true
VECTOR_WEIGHT=0.6
BM25_WEIGHT=0.4

# --- Agentic RAG (Unidad 2 · tendencias 2026) ---
AGENTIC_MODE=true
MIN_RELEVANCE_SCORE=0.35
MAX_RETRIEVAL_ROUNDS=2

# --- Generación local vía Ollama (gratuito, sin API key) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
GENERATION_TEMPERATURE=0.2

# --- Política de evidencia y citas (P1-1 / P1-2) ---
# EVIDENCE_POLICY=false conserva el comportamiento original (siempre se llama al LLM).
EVIDENCE_POLICY=true
EVIDENCE_SCORER=cosine
EVIDENCE_LOW=0.35
EVIDENCE_HIGH=0.60
# v1 = prompt original; v2 = prompt con citas numeradas [n] validadas por el backend
PROMPT_VERSION=v2
